  "json_list_len": 2,
  "sample": "[{\"id\":\"574158\",\"ticker\":\"will-valve-add-sticker-trade-ups-before-november-20260608173609897\",\"slug\":\"will-valve-add-sticker-trade-ups-before-november-20260608173609897\",\"title\":\"Will Valve add sticker trade-ups before November?\",\"description\":\"This market will resolve to \\\"Yes\\\" if Valve adds sticker trade-ups to Counter-Strike 2 (CS2) by October 31, 2026, 11:59 PM ET. Otherwise, this market will resolve to \\\"No.\\\"\\n\\nFor the purposes of this market, \\\"sticker trade-ups\\\" is defined as an officially supported in-game mechanic that allows players to combine or exchange multiple stickers to receive a higher-tier sticker. The feature must be fully implemented and accessible to all players in the live game client.\\n\\nIf the feature is added as a limited-time, temporary, or beta mechanic that is reversed or removed within 48 hours of its introduction, this market will resolve to \\\"No.\\\" This market will remain open for 48 hours after a qualifying feature is released.\\n\\nFor the purpose of this market, \\\"Valve\\\" refers to Valve Corporation, the developer and publisher of the Counter-Strike series.\\n\\nThe primary resolution source for this market will be official information from Valve; however, a consensus of credible reporting may also be used.\",\"resolutionSource\":\"\",\"startDate\":\"2026-06-08T22:24:12.899439Z\",\"creationDate\":\"2026-06-08T22:32:04.960199Z\",\"endDate\":\"2026-11-01T03:59:00Z\",\"active\":true,\"closed\":false,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":true,\"liquidity\":522.89379,\"volume\":1737.9054780000001,\"openInterest\":1167.840862,\"sortBy\":\"ascending\",\"createdAt\":\"2026-06-08T22:22:03.321921Z\",\"updatedAt\":\"2026-10-16T10:14:22.485976Z\",\"competitive\":0.8117922566789701,\"enableOrderBook\":true,\"liquidityClob\":522.89379,\"negRisk\":false,\"commentCount\":0,\"markets\":[{\"id\":\"2473852\",\"question\":\"Will Valve add sticker trade-ups before N